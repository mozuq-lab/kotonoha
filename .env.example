# =============================================================================
# ルート .env — docker-compose の変数展開と Flutter ビルドに使う設定
# =============================================================================
#
# 【重要】バックエンドのアプリ設定はこのファイルではなく backend/.env に書きます。
#
# docker-compose.yml の environment に書いた値はOS環境変数としてコンテナに渡り、
# pydantic-settings では backend/.env より優先されます。そのため compose には
# infra層の値だけを置き、アプリ設定（AIキー・API_KEYS・レート制限・CORS・ログ等）は
# backend/.env で管理する方針です。
# このファイルにアプリ設定を書いてもバックエンドには届きません。
#
#   cp .env.example .env                      # このファイル
#   cp backend/.env.example backend/.env      # アプリ設定はこちら
#
# =============================================================================

# -----------------------------------------------------------------------------
# docker-compose が参照する変数
# -----------------------------------------------------------------------------
POSTGRES_USER=kotonoha_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kotonoha_db
POSTGRES_PORT=5432

# バックエンドの署名鍵。未設定だと docker-compose が起動を拒否します。
SECRET_KEY=your_secret_key_here_please_change_this_to_random_string

# -----------------------------------------------------------------------------
# Flutter ビルド時に --dart-define で埋め込む変数
# -----------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000

# 端末APIキー。backend/.env の API_KEYS に含まれる値のいずれかを指定します。
# （API_KEYS 自体はバックエンドの設定なので backend/.env 側で管理します）
AI_API_KEY=
