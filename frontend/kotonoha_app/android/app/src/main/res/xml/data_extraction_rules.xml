<?xml version="1.0" encoding="utf-8"?>
<!--
    kotonoha のデータ抽出規則（Android 12 以上の端末用。11 以下は backup_rules.xml）。

    クラウドバックアップも端末間転送も、対象は設定（SharedPreferences）だけにする。
    <include> を書くとそれ以外は対象外になるので、Hive のファイル（利用者の会話内容）は
    Google のバックアップにも新端末への転送にも載らない（NFR-101、プライバシーポリシー
    「入力した内容は端末内にのみ保存」）。この規則が無いと、Android 12 以上では既定で
    アプリの全ファイルがバックアップ対象になる。
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
