# Kotonoha Fastlane Configuration
# https://docs.fastlane.tools

default_platform(:android)

# iOS の TestFlight への送信は scripts/ios-testflight.sh（fastlane を使わない）。
# App Store のメタデータとスクリーンショットは fastlane/metadata・fastlane/screenshots にあり、
# App Store Connect に手で入れる。

# Android Configuration
platform :android do
  desc "Submit a new internal testing build to Google Play"
  lane :internal do
    sh "cd ../.. && flutter build appbundle --release --flavor production"

    upload_to_play_store(
      track: 'internal',
      aab: '../build/app/outputs/bundle/productionRelease/app-production-release.aab',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy a new version to Google Play"
  lane :release do
    sh "cd ../.. && flutter build appbundle --release --flavor production"

    upload_to_play_store(
      track: 'production',
      aab: '../build/app/outputs/bundle/productionRelease/app-production-release.aab',
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Update metadata on Google Play"
  lane :update_metadata do
    upload_to_play_store(
      track: 'production',
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
